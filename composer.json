{
    "name": "jm1105/sgen-support",
    "description": "Sistema de gestión de soporte técnico, inventario y auditoría con arquitectura MVC.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jonás Mendoza",
            "role": "Lead Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        },
        "audit": {
            "ignore": [
                "PKSA-gh7h-hhy4-byg7",
                "PKSA-6r8f-nxsb-67bq",
                "PKSA-cv56-2228-pzr6",
                "PKSA-mwt3-h9tv-kx78",
                "PKSA-mckv-s5hg-868k",
                "PKSA-hp6n-n4kz-21wk",
                "PKSA-rdkp-vv9z-mjkg"
            ]
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ],
        "migrate": "php migrations/run_migration.php"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
