{
    "name": "jm1105/sgen-support",
    "description": "Sistema de gestión de soporte técnico, inventario y auditoría con arquitectura MVC.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jonás Mendoza",
            "role": "Lead Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ],
        "migrate": "php migrations/run_migration.php"
    }
}