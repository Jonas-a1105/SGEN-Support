# =============================================
# SGEN-Support - Environment Configuration
# =============================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo como .env
# 2. Configurar los valores para tu entorno
# 3. NUNCA subir .env al repositorio
# 
# =============================================

# =============================================
# APLICACIÓN
# =============================================
# Entorno: local | production
APP_ENV=local

# Modo debug (true solo en desarrollo)
APP_DEBUG=true

# URL base de la aplicación
# Ejemplo producción: https://soporte.miempresa.com/public
APP_URL=http://localhost/sgen-support/public

# Zona horaria
TIMEZONE=America/Caracas

# =============================================
# BASE DE DATOS
# =============================================
DB_HOST=localhost
DB_NAME=sgen_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# =============================================
# CORREO ELECTRÓNICO (SMTP - PHPMailer)
# =============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_password_aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=soporte@miempresa.com
MAIL_FROM_NAME="Soporte Técnico"

# =============================================
# SEGURIDAD
# =============================================
# Tiempo de inactividad para cerrar sesión (segundos)
SESSION_LIFETIME=7200

# =============================================
# ⚠️  NOTAS IMPORTANTES PARA PRODUCCIÓN
# =============================================
# 
# 1. APP_DEBUG=false (OBLIGATORIO)
#    Expone información sensible si está en true
# 
# 2. DB_USER: NO usar 'root' en producción
#    Crear usuario específico:
#    CREATE USER 'sgen_user'@'localhost' IDENTIFIED BY 'contraseña';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON sgen_db.* TO 'sgen_user'@'localhost';
# 
# 3. DB_PASS: Usar contraseña fuerte (mín. 16 caracteres)
#    Combinar: mayúsculas + minúsculas + números + símbolos
# 
# 4. APP_URL: Usar HTTPS en producción
# 
# 5. MAIL_PASS: Usar "Contraseña de Aplicación" de Gmail
#    No usar tu contraseña real de correo
#    https://myaccount.google.com/apppasswords
# 
# =============================================
