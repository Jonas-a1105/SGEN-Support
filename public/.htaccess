<IfModule mod_rewrite.c>
    Options -Multiviews
    RewriteEngine On

    # Si el archivo o carpeta existe físicamente (imágenes, CSS, JS), servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f

    # Si no existe, enviarlo todo a index.php
    RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>