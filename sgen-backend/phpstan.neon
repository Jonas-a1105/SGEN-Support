includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - app/
        - src/
    excludePaths:
        - src/Modules/*/Domain/Models/* # Entidades de dominio con hidratación dinámica deliberada
    treatPhpDocTypesAsCertain: false
